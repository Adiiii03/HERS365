# API origin for the production web build. Leave EMPTY for same-origin (the client
# and API are served from the same host in prod, so /api/... resolves directly).
# If set, it MUST be a full https:// origin (e.g. https://srv1829607.hstgr.cloud) for
# a cross-origin frontend. A path like /api double-prefixes requests and 404s.
VITE_API_URL=
VITE_REGISTRATION_ENABLED=true
