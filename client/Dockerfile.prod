# client/Dockerfile.prod
# Multi-stage: build the Vite SPA, then serve the static output with nginx.
# nginx also reverse-proxies /api and /health to the API container so the
# browser only ever talks to one origin (https://HERS365.app) in production.

# Stage 1: build the client
FROM node:20-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci 

COPY . .
RUN npm run build

# Stage 2: serve with nginx
FROM nginx:1.27-alpine

COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
